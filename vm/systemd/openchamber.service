[Unit]
Description=OpenChamber 24/7 (agent farm UI)
After=network-online.target
Wants=network-online.target

[Service]
User=farm
EnvironmentFile=/home/farm/agent-farm/.openchamber.env
ExecStart=/home/farm/agent-farm/bin/openchamber-run.sh
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
